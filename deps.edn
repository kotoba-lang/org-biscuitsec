{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       ;; The wire format's protobuf codec. `biscuit.wire` is the interop
        ;; face; the model namespaces do not require it.
        io.github.kotoba-lang/dev-protobuf
        {:git/url "https://github.com/kotoba-lang/dev-protobuf.git"
         :git/sha "3f20b1e1cdbe89750d8afaf24f64777a2f170c3c"}
        io.github.kotoba-lang/authority
        {:git/url "https://github.com/kotoba-lang/authority.git"
         :git/sha "232eef9b7969aa5990f9b5e48b1184f078500781"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; Real Ed25519 for the one suite that must not use a
                      ;; stand-in. Test-only: this library injects sign/verify
                      ;; and must not acquire a curve implementation.
                      io.github.kotoba-lang/org-ietf-ed25519
                      {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
                       :git/sha "6117bf17fceef4f95e33e6db2e0daa25553c0f0e"}
                      ;; The Kotoba compiler and KIR interpreter, so
                      ;; `kotoba/biscuit/scope.kotoba` is driven by the suite
                      ;; rather than described by it.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "2cb7d3f18205eadb3791441d3c3e09d9eb9b1a22"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "56911149694ddaa382ce7d214ed62c69a2d917c5"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
